# ====================================================================
# Hostinger LiteSpeed / Apache Configuration for Resa AI Assistant
# ====================================================================
# NOTE FOR HOSTINGER NODE.JS USERS:
# If you created a Node.js Application in Hostinger hPanel, Hostinger
# will auto-generate a "PASSENGER CONFIGURATION" block at the top of this
# file. DO NOT DELETE THAT BLOCK - it tells LiteSpeed to run app.js!
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent directory browsing
  Options -Indexes

  # 3. For Static / Shared hosting fallback (only if Node.js is NOT active):
  # Check if index.html exists in the request directory
  <IfModule !mod_passenger.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [QSA,L]
  </IfModule>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
